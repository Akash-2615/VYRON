# Copy to .env (never commit .env).
#
# ── Database (REQUIRED — local Postgres) ─────────────────────────────
# The app will not start without a working DATABASE_URL.
# Face crops + events.log stay on the local filesystem (logs/).
#
# Start local DB:
#   docker compose up -d db
#
DATABASE_URL=postgresql://facetrack:facetrack@localhost:5432/facetrack
#
# TRACKER_DSN=   # alias for DATABASE_URL

# Optional dashboard assistant (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Model names change — check https://console.groq.com/docs/models
ASSISTANT_ENABLED=true
ASSISTANT_MAX_TOOL_ROUNDS=5
