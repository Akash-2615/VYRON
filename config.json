{
  "video_source": "data/videos/video_sample1.mp4",
  "video_sources": [],
  "detection_skip_frames": 0,

  "detector": {
    "weights": "data/models/yolov8n-face.pt",
    "weights_url": "https://github.com/akanametov/yolo-face/releases/download/1.0.0/yolov8n-face.pt",
    "conf_threshold": 0.12,
    "imgsz": 768,
    "device": "auto"
  },

  "retina_face": {
    "enabled": false,
    "conf_threshold": 0.30,
    "det_size": 640,
    "device": "auto",
    "verify_below_conf": 0.50,
    "verify_iou": 0.30,
    "fallback_on_empty": true,
    "model_path": ""
  },

  "recognition": {
    "model_pack": "buffalo_l",
    "det_size": 640,
    "match_threshold": 0.52,
    "soft_match_margin": 0.06,
    "min_match_gap": 0.04,
    "anti_split_threshold": 0.48,
    "register_min_det_score": 0.38,
    "mismatch_margin": 0.10,
    "max_embeddings_per_face": 5,
    "min_embeds_to_register": 2,
    "embed_retry_interval": 1,
    "max_embed_attempts": 16,
    "max_identify_per_frame": 12
  },

  "quality": {
    "min_face_px": 10,
    "min_blur_var": 6.0
  },

  "appearance": {
    "enabled": true,
    "model": "ViT-B-32",
    "pretrained": "openai",
    "device": "auto",
    "min_crop_px": 48,
    "describe_on_register": true
  },

  "away_walkers": {
    "enabled": true,
    "require_facing_away": false,
    "away_score_min": 0.30,
    "detect_every_n": 1,
    "describe_away": false,
    "head_roi_min_px": 140,
    "max_head_roi_per_cycle": 6,
    "reentry_grace_frames": 120,
    "reentry_grace_sec": 30.0
  },
  "person_detector": {
    "weights": "data/models/yolov8n.pt",
    "conf_threshold": 0.15,
    "imgsz": 640,
    "device": "auto",
    "min_height_px": 32,
    "min_width_px": 16,
    "min_aspect": 0.85,
    "max_aspect": 5.5,
    "nms_iou": 0.50
  },
  "away_tracker": {
    "high_conf": 0.32,
    "new_track_conf": 0.32,
    "low_conf": 0.15,
    "iou_threshold": 0.22,
    "low_iou_threshold": 0.18,
    "min_hits": 1,
    "max_lost_frames": 45
  },

  "tracker": {
    "high_conf": 0.30,
    "new_track_conf": 0.30,
    "low_conf": 0.12,
    "iou_threshold": 0.22,
    "low_iou_threshold": 0.18,
    "min_hits": 1,
    "max_lost_frames": 50,
    "reentry_grace_frames": 90,
    "reentry_grace_sec": 30.0
  },

  "presence": {
    "exit_grace_seconds": 10,
    "edge_exit_grace_seconds": 2,
    "stationary_grace_seconds": 45,
    "occlusion_grace_multiplier": 2.0,
    "edge_margin_px": 24,
    "stationary_speed_px_s": 15,
    "resume_spatial_iou": 0.15,
    "resume_threshold_margin": 0.05,
    "reverify_interval_seconds": 5,
    "occlusion_iou": 0.3,
    "mass_loss_ratio": 0.6,
    "max_stream_gap_seconds": 20,
    "exit_zones": []
  },
  "timestamps": "auto",

  "logging": {
    "level": "INFO",
    "separate_away_log": true,
    "debug_events": false
  },

  "storage": {
    "backend": "postgres",
    "postgres": {},
    "log_dir": "logs",
    "events_log": "logs/events.log",
    "reset_on_start": false
  },

  "stream": {
    "reconnect_delay_sec": 3,
    "max_reconnects": 0,
    "read_timeout_sec": 10,
    "realtime": true,
    "catch_up_drop": true,
    "process_max_width": 1280,
    "stream_gap_seconds": 1.5
  },

  "output": {
    "display": false,
    "annotated_video": "",
    "live_preview": "data/runtime/live.jpg",
    "live_jpeg_quality": 72,
    "live_max_width": 960,
    "live_every_n_frames": 2
  },

  "preprocess": {
    "enabled": false,
    "process_at_detector_resolution": true,
    "mode": "async",
    "max_wait_ms": 50,
    "auto_gate": {
      "enabled": true,
      "brightness_below": 90,
      "contrast_below": 35,
      "mode": "any"
    },
    "denoise": { "enabled": false, "method": "gaussian", "strength": 0.35 },
    "white_balance": { "enabled": false, "strength": 0.6, "max_gain": 1.5 },
    "gamma": { "enabled": false, "gamma": 0.75, "auto_target_mean": 0 },
    "clahe": { "enabled": false, "clip_limit": 2.0, "tile_grid": 8 },
    "sharpen": { "enabled": false, "amount": 0.3, "sigma": 1.0 },
    "quality_assist": { "enabled": false }
  }
}
