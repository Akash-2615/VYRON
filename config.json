{
  "video_source": "data/videos/sample_video.mp4",
  "video_sources": [],
  "detection_skip_frames": 2,
  "detector": {
    "weights": "data/models/yolov8n-face.pt",
    "weights_url": "https://github.com/akanametov/yolo-face/releases/download/1.0.0/yolov8n-face.pt",
    "conf_threshold": 0.22,
    "imgsz": 640,
    "device": "auto"
  },
  "retina_face": {
    "enabled": true,
    "conf_threshold": 0.35,
    "det_size": 640,
    "device": "auto",
    "verify_below_conf": 0.45,
    "verify_iou": 0.3,
    "fallback_on_empty": true,
    "model_path": ""
  },
  "recognition": {
    "model_pack": "buffalo_l",
    "det_size": 640,
    "match_threshold": 0.45,
    "max_embeddings_per_face": 5,
    "min_embeds_to_register": 2,
    "embed_retry_interval": 1,
    "max_embed_attempts": 12
  },
  "quality": {
    "min_face_px": 16,
    "min_blur_var": 12.0
  },
  "appearance": {
    "enabled": false,
    "model": "ViT-B-32",
    "pretrained": "openai",
    "device": "auto",
    "min_crop_px": 48,
    "describe_on_register": true
  },
  "away_walkers": {
    "enabled": true,
    "require_facing_away": false,
    "away_score_min": 0.35,
    "detect_every_n": 2,
    "describe_away": false,
    "head_roi_min_px": 220,
    "reentry_grace_frames": 120,
    "reentry_grace_sec": 30.0
  },
  "person_detector": {
    "weights": "data/models/yolov8n.pt",
    "conf_threshold": 0.42,
    "imgsz": 512,
    "device": "auto",
    "min_height_px": 60,
    "min_width_px": 20,
    "min_aspect": 1.1,
    "max_aspect": 5.5
  },
  "away_tracker": {
    "high_conf": 0.4,
    "new_track_conf": 0.4,
    "iou_threshold": 0.22,
    "min_hits": 2,
    "max_lost_frames": 30
  },
  "tracker": {
    "high_conf": 0.35,
    "new_track_conf": 0.28,
    "iou_threshold": 0.25,
    "min_hits": 2,
    "max_lost_frames": 30,
    "reentry_grace_frames": 75,
    "reentry_grace_sec": 25.0
  },
  "presence": {
    "exit_grace_seconds": 10,
    "edge_exit_grace_seconds": 2,
    "stationary_grace_seconds": 45,
    "occlusion_grace_multiplier": 2.0,
    "edge_margin_px": 24,
    "stationary_speed_px_s": 15,
    "resume_spatial_iou": 0.2,
    "resume_threshold_margin": 0.05,
    "reverify_interval_seconds": 5,
    "occlusion_iou": 0.3,
    "mass_loss_ratio": 0.6,
    "max_stream_gap_seconds": 20,
    "exit_zones": []
  },
  "timestamps": "auto",
  "logging": {
    "level": "INFO",
    "separate_away_log": true,
    "debug_events": false
  },
  "storage": {
    "backend": "postgres",
    "postgres": {},
    "log_dir": "logs",
    "events_log": "logs/events.log",
    "reset_on_start": false
  },
  "stream": {
    "reconnect_delay_sec": 3,
    "max_reconnects": 0,
    "read_timeout_sec": 10,
    "realtime": true,
    "catch_up_drop": true,
    "stream_gap_seconds": 1.5
  },
  "output": {
    "display": false,
    "annotated_video": "",
    "live_preview": "data/runtime/live.jpg",
    "live_jpeg_quality": 85,
    "live_max_width": 0,
    "live_every_n_frames": 2
  }
}
